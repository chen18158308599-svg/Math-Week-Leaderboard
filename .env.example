# Supabase project settings (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key — server-only, never expose to the browser. Used for anything that
# awards points, validates a claim token/card answer, or serves the admin panel.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Domain restriction (defense in depth — the primary gate is the Azure AD app
# registration being single-tenant; configure that in Supabase Dashboard →
# Authentication → Providers → Azure). Just the domain, no @.
ALLOWED_EMAIL_DOMAIN=university.edu
